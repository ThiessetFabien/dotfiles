{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 1,
  "margin-top": 4,
  "margin-bottom": 0,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "network",
    "bluetooth", 
    "battery",
    "pulseaudio",
    "backlight",
    "memory",
    "cpu",
    "custom/lock",
    "custom/restart",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{name} {icon}",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
    },
    "format-icons": {
      "1": "💻",
      "2": "🌐", 
      "3": "📱",
      "4": "🖥️",
      "5": "🔧",
      "6": "📚",
      "7": "🎨",
      "8": "💬",
      "9": "🎵",
      "default": "💼"
    }
  },
  "custom/lock": {
    "format": "󰍁",
    "on-click": "hyprlock",
    "tooltip": true,
    "tooltip-format": "Verrouiller l'écran"
  },
  "custom/restart": {
    "format": "󰜉",
    "on-click": "systemctl reboot",
    "tooltip": true,
    "tooltip-format": "Redémarrer"
  },
  "custom/power": {
    "format": "󰤆",
    "on-click": "systemctl poweroff",
    "tooltip": true,
    "tooltip-format": "Éteindre"
  },
  "network": {
    "format-wifi": "{essid}  {signalStrength}%",
    "format-ethernet": "󰈀  Connected",
    "tooltip-format": "󰅃 {bandwidthUpBytes} 󰅀 {bandwidthDownBytes}",
    "format-linked": "󱘖  Linked",
    "format-disconnected": "󰤭  Disconnected",
    "format-alt": "󰤨  {signalStrength}%",
    "on-click": "",
    "on-click-right": "nm-connection-editor",
    "interval": 5
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󱐋  {capacity}%",
    "format-plugged": "󰚥  {capacity}%",
    "interval": 10,
    "format-icons": ["󰂎", "󰁼", "󰁿", "󰂁", "󰁹"],
    "tooltip": true,
    "tooltip-format": "Batterie: {capacity}% - {time}"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  {volume}%",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󱡏",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰦢",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click-right": "pavucontrol -t 3",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "scroll-step": 2,
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%"
  },
  "memory": {
    "format": "󰍛  {percentage}%",
    "interval": 5,
    "on-click": "kitty -e htop",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.2f}G/{total:0.2f}G ({percentage}%)"
  },
  "cpu": {
    "format": "󰻠  {usage}%",
    "interval": 5,
    "on-click": "kitty -e htop",
    "tooltip": true,
    "tooltip-format": "CPU: {usage}% - Charge: {load}"
  },
  "clock": {
    "interval": 60,
    "timezone": "Europe/Paris",
    "locale": "fr_FR.utf8",
    "format": "{:%H:%M}",
    "format-alt": "{:%d/%m/%Y}",
    "tooltip": true,
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffffff'><b>{}</b></span>",
        "days": "<span color='#c0c0c0'><b>{}</b></span>",
        "weeks": "<span color='#808080'><b>S{}</b></span>",
        "weekdays": "<span color='#a0a0a0'><b>{}</b></span>",
        "today": "<span color='#ffffff'><b><u>{}</u></b></span>"
      }
    }
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8,
    "show-passive-items": false,
    "reverse-direction": false
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}  {percent}%",
    "tooltip": true,
    "tooltip-format": "Luminosité: {percent}%",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "format-icons": ["󰃞", "󰃟", "󰃠"]
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱  {device_battery_percentage}%",
    "format-connected-battery": "󰂱  {device_battery_percentage}%",
    "on-click": "blueman-manager",
    "on-click-right": "blueman-manager",
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "Connecté: {device_alias}\nBatterie: {device_battery_percentage}%",
    "tooltip-format-enumerate-connected": "{device_alias} - {device_battery_percentage}%",
    "tooltip-format-enumerate-connected-battery": "{device_alias} - {device_battery_percentage}%"
  }
}
